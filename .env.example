# Local MySQL (docker/docker-compose.dev.yml)
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=dodep
MYSQL_PASSWORD=dodep

# Docker images (scripts/docker.mjs). TAG defaults to the short git sha.
REGISTRY=areaweb.registry.twcstorage.ru
IMAGE_API=dodep-api
IMAGE_APP=dodep-app
IMAGE_ADMIN=dodep-admin
PLATFORM=linux/amd64
# Baked into the admin static build (the browser sees it anyway)
ADMIN_SENTRY_DSN=
ADMIN_SITE_URL=https://dodep.fun
SENTRY_ENVIRONMENT=production
