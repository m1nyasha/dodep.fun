{
  "name": "dodep",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:shared": "pnpm --filter @dodep/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @dodep/shared --filter @dodep/api --filter @dodep/app dev",
    "lint": "pnpm -r lint && eslint scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test && node --test \"scripts/__tests__/*.test.mjs\"",
    "test:e2e": "pnpm build:shared && pnpm --filter @dodep/api test:e2e",
    "db:up": "docker compose -f docker/docker-compose.dev.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.dev.yml --env-file .env down",
    "docker:build": "node scripts/docker.mjs build",
    "docker:push": "node scripts/docker.mjs push"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
